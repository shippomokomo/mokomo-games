---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import HomeAbout from '../components/home/HomeAbout.astro';
import HomeGuidelines from '../components/home/HomeGuidelines.astro';
import MediaLightbox from '../components/MediaLightbox.astro';
import { withBase } from '../utils/paths';
import { getScheduleImages } from '../utils/media';
import { contactUrl } from '../data/links';

const schedules = getScheduleImages();

/*
 * Homeには最新2件だけ表示
 */
const latestSchedules = schedules.slice(0, 2);

const contents = [
  {
    title: 'References',
    description: '三面図などの資料を掲載しています！',
    href: '/references/',
  },
  {
    title: 'Illustrations',
    description:
      '頂いたファンアートやコミッションイラスト等をこちらでご紹介しています！',
    href: '/illustrations/',
  },
  {
    title: 'Archives',
    description:
      'YouTubeの配信アーカイブ、その他動画へのリンクです！ゲームタイトルで検索できます！',
    href: '/archives/',
  },
  {
    title: 'Works',
    description:
      '出演させていただいたゲーム作品等をこちらでご紹介しています！',
    href: '/works/',
  },
];

const stores = [
  {
    title: 'BOOTH',
    description: 'こちらでもこものグッズ販売をしています！',
    href: 'https://shippomokomo.booth.pm/',
  },
  {
    title: 'LINE Stickers',
    description:
      'もこも＆もここのLINEスタンプを公開しています！',
    href: 'https://store.line.me/stickershop/product/30400033/',
  },
];

const links = [
  {
    title: 'YouTube',
    href: 'https://www.youtube.com/@mokomo',
  },
  {
    title: 'X',
    href: 'https://x.com/shippomokomo',
  },
  {
    title: 'Bluesky',
    href: 'https://bsky.app/profile/shippomokomo.bsky.social',
  },
  {
    title: 'Instagram',
    href: 'https://www.instagram.com/shippomokomo/',
  },
  {
    title: 'VRoid Hub',
    href: 'https://hub.vroid.com/users/78987251',
  },
  {
    title: 'Amazon Wishlist',
    href: 'https://www.amazon.jp/hz/wishlist/ls/CF4UZ9QV6S35?ref_=wl_share',
  },
];

---

<BaseLayout
  title="Mokomo Games | 七宝もこも"
  description="インディーゲームやパズルゲームを中心にライブ配信をしている、七宝もこもの公式サイトです。配信予定、アーカイブ、イラスト、キャラクター資料などを掲載しています。"
>
  <div class="home-page">

    <!-- メインビジュアル -->
    <section class="hero">
      <div class="hero-image">
        <img
          src={withBase('/images/home/main-visual.webp')}
          alt="七宝もこも / Shippo Mokomo"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="hero-content">
        <h1>
          <span class="name-ja">七宝もこも</span>
          <span class="name-en">Shippo Mokomo</span>
        </h1>

        <div class="hero-links">
          <a
            href="https://www.youtube.com/@mokomo"
            target="_blank"
            rel="noopener noreferrer"
          >
            YouTube
          </a>

          <a
            href="https://x.com/shippomokomo"
            target="_blank"
            rel="noopener noreferrer"
          >
            X
          </a>

          <a
            href="https://bsky.app/profile/shippomokomo.bsky.social"
            target="_blank"
            rel="noopener noreferrer"
          >
            Bluesky
          </a>
        </div>
      </div>
    </section>

    <!-- メインビジュアルとコンテンツの区切り線 -->
    <div class="hero-divider" aria-hidden="true"></div>

    <!-- About -->
    <section class="home-section about-section">
      <h2>About</h2>
      <HomeAbout />
    </section>

    <!-- Latest Schedule -->
    <section class="home-section">
      <h2>Latest Schedule</h2>

      {
        latestSchedules.length > 0 ? (
          <>
            <div class="schedule-grid">
              {latestSchedules.map((schedule, index) => (
                <button
                  class="schedule-card"
                  type="button"
                  data-lightbox-trigger
                  data-schedule-index={index}
                  aria-label={`${schedule.dateLabel} のスケジュールを拡大表示`}
                >
                  <img
                    src={schedule.url}
                    alt={`${schedule.dateLabel} の配信スケジュール`}
                    loading="lazy"
                  />
                </button>
              ))}
            </div>

            <div class="section-link">
              <a href={withBase('/schedule/')}>
                過去のスケジュールを見る
              </a>
            </div>
          </>
        ) : (
          <p>現在掲載中のスケジュールはありません。</p>
        )
      }
    </section>

    <!-- Contents -->
    <section class="home-section">
      <h2>Contents</h2>

      <div class="card-grid">
        {
          contents.map((item) => (
            <a class="info-card" href={withBase(item.href)}>
              <h3>{item.title}</h3>
              <p>{item.description}</p>

              <span
                class="card-arrow"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Stores -->
    <section class="home-section">
      <h2>Stores</h2>

      <div class="card-grid store-grid">
        {
          stores.map((store) => (
            <a
              class="info-card"
              href={store.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <h3>{store.title}</h3>
              <p>{store.description}</p>

              <span
                class="card-arrow"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Links -->
    <section class="home-section">
      <h2>Links</h2>

      <div class="link-list">
        {
          links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.title}
            </a>
          ))
        }
      </div>
    </section>

    <!-- Guidelines -->
    <section class="home-section guidelines-section">
      <h2>Guidelines</h2>
      <HomeGuidelines />
    </section>

    <!-- Contact -->
    <section class="home-section contact-section">
      <h2>Contact</h2>

      <p>
        ご連絡・お問い合わせはこちらからお願いいたします。
      </p>

      <p lang="en">
        For inquiries, please use the contact form below.
      </p>

      <a
        class="contact-button"
        href={contactUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        お問い合わせ / Contact
      </a>
    </section>

  </div>

  <MediaLightbox id="schedule-lightbox" />
</BaseLayout>

<script src="../scripts/home.ts"></script>
