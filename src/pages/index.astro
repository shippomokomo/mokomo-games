---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';

/*
 * Scheduleページと同じルールで
 * public/images/schedule 内のWebP画像を取得
 */
const scheduleModules = import.meta.glob(
  '/public/images/schedule/*.webp',
  {
    eager: true,
    query: '?url',
    import: 'default',
  }
);

/*
 * schedule_YYYYMMDD.webp から日付を取得し、
 * 新しい順に並べる
 */
const schedules = Object.entries(scheduleModules)
  .map(([path, url]) => {
    const filename = path.split('/').pop() ?? '';

    const match = filename.match(
      /^schedule_(\d{4})(\d{2})(\d{2})\.webp$/
    );

    if (!match) return null;

    const [, year, month, day] = match;

    return {
      filename,
      url: withBase(`/images/schedule/${filename}`),
      dateValue: Number(`${year}${month}${day}`),
      dateLabel: `${year}-${month}-${day}`,
    };
  })
  .filter((item) => item !== null)
  .sort((a, b) => b.dateValue - a.dateValue);

/*
 * Homeには最新2件だけ表示
 */
const latestSchedules = schedules.slice(0, 2);

const contents = [
  {
    title: 'References',
    description: '三面図などの資料を掲載しています！',
    href: '/references/',
  },
  {
    title: 'Illustrations',
    description:
      '頂いたファンアートやコミッションイラスト等をこちらでご紹介しています！',
    href: '/illustrations/',
  },
  {
    title: 'Archives',
    description:
      'YouTubeの配信アーカイブ、その他動画へのリンクです！ゲームタイトルで検索できます！',
    href: '/archives/',
  },
  {
    title: 'Works',
    description:
      '出演させていただいたゲーム作品等をこちらでご紹介しています！',
    href: '/works/',
  },
];

const stores = [
  {
    title: 'BOOTH',
    description: 'こちらでもこものグッズ販売をしています！',
    href: 'https://shippomokomo.booth.pm/',
  },
  {
    title: 'LINE Stickers',
    description:
      'もこも＆もここのLINEスタンプを公開しています！',
    href: 'https://store.line.me/stickershop/product/30400033/',
  },
];

const links = [
  {
    title: 'YouTube',
    href: 'https://www.youtube.com/@mokomo',
  },
  {
    title: 'X',
    href: 'https://x.com/shippomokomo',
  },
  {
    title: 'Bluesky',
    href: 'https://bsky.app/profile/shippomokomo.bsky.social',
  },
  {
    title: 'Instagram',
    href: 'https://www.instagram.com/shippomokomo/',
  },
  {
    title: 'VRoid Hub',
    href: 'https://hub.vroid.com/users/78987251',
  },
  {
    title: 'Amazon Wishlist',
    href: 'https://www.amazon.jp/hz/wishlist/ls/CF4UZ9QV6S35?ref_=wl_share',
  },
];

const contactUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLSfYv8hTEEF-RUeLCQTIECUldygrhvK21UBx7l3mQHLPyE2OyQ/viewform?usp=dialog';
---

<BaseLayout title="Mokomo Games">
  <main class="home-page">

    <!-- メインビジュアル -->
    <section class="hero">
      <div class="hero-image">
        <img
          src={withBase('/images/home/main-visual.webp')}
          alt="七宝もこも / Shippo Mokomo"
        />
      </div>

      <div class="hero-content">
        <h1>
          <span class="name-ja">七宝もこも</span>
          <span class="name-en">Shippo Mokomo</span>
        </h1>

        <div class="hero-links">
          <a
            href="https://www.youtube.com/@mokomo"
            target="_blank"
            rel="noopener noreferrer"
          >
            YouTube
          </a>

          <a
            href="https://x.com/shippomokomo"
            target="_blank"
            rel="noopener noreferrer"
          >
            X
          </a>

          <a
            href="https://bsky.app/profile/shippomokomo.bsky.social"
            target="_blank"
            rel="noopener noreferrer"
          >
            Bluesky
          </a>
        </div>
      </div>
    </section>

    <!-- メインビジュアルとコンテンツの区切り線 -->
    <div class="hero-divider" aria-hidden="true"></div>

    <!-- About -->
    <section class="home-section about-section">
      <h2>About</h2>

      <div class="about-card">
        <div class="about-introduction">
          <p>
            インディーゲー＆雑談好きの、パズル＆英語つよつよタヌキです！<br />
            趣味でライブ配信をしています！
          </p>

          <p lang="en">
            Mokomo, the most joyful and nerdy indie game streamer!
          </p>
        </div>

        <dl class="about-details">
          <div>
            <dt>初配信</dt>
            <dd><time datetime="2021-09-05">2021年9月5日</time></dd>
          </div>
          <div>
            <dt>誕生日</dt>
            <dd><time datetime="04-21">4月21日</time></dd>
          </div>
          <div>
            <dt>ハッシュタグ</dt>
            <dd>#ななもこ</dd>
          </div>
          <div>
            <dt>イラストタグ</dt>
            <dd>#ななもこアート</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Latest Schedule -->
    <section class="home-section">
      <h2>Latest Schedule</h2>

      {
        latestSchedules.length > 0 ? (
          <>
            <div class="schedule-grid">
              {latestSchedules.map((schedule, index) => (
                <button
                  class="schedule-card"
                  type="button"
                  data-schedule-index={index}
                  aria-label={`${schedule.dateLabel} のスケジュールを拡大表示`}
                >
                  <img
                    src={schedule.url}
                    alt={`${schedule.dateLabel} の配信スケジュール`}
                    loading="lazy"
                  />
                </button>
              ))}
            </div>

            <div class="section-link">
              <a href={withBase('/schedule/')}>
                過去のスケジュールを見る
              </a>
            </div>
          </>
        ) : (
          <p>現在掲載中のスケジュールはありません。</p>
        )
      }
    </section>

    <!-- Contents -->
    <section class="home-section">
      <h2>Contents</h2>

      <div class="card-grid">
        {
          contents.map((item) => (
            <a class="info-card" href={withBase(item.href)}>
              <h3>{item.title}</h3>
              <p>{item.description}</p>

              <span
                class="card-arrow"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Stores -->
    <section class="home-section">
      <h2>Stores</h2>

      <div class="card-grid store-grid">
        {
          stores.map((store) => (
            <a
              class="info-card"
              href={store.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <h3>{store.title}</h3>
              <p>{store.description}</p>

              <span
                class="card-arrow"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Links -->
    <section class="home-section">
      <h2>Links</h2>

      <div class="link-list">
        {
          links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.title}
            </a>
          ))
        }
      </div>
    </section>

    <!-- Guidelines -->
    <section class="home-section guidelines-section">
      <h2>Guidelines</h2>

      <div class="guidelines-card">
        <p class="guidelines-introduction">
          七宝もこも・もここのファンアートや二次創作を歓迎しています。制作・公開の際は、以下のガイドラインをご確認ください。
        </p>

        <section class="guideline-item">
          <h3>Prohibited Uses</h3>
          <p>以下の目的や内容での利用は禁止します。</p>
          <ul>
            <li>誹謗中傷、嫌がらせ、差別、第三者を傷つける目的での利用</li>
            <li>政治的・宗教的な主張、宣伝、勧誘、活動への利用</li>
            <li>R-18、R-18Gに該当する表現</li>
            <li>七宝もこも本人や関係者、公式作品であると誤解させる表現</li>
            <li>その他、七宝もこも・もここのイメージを著しく損なう利用</li>
          </ul>
        </section>

        <section class="guideline-item">
          <h3>Fan Art</h3>
          <p>
            ファンアートを公開する際は、イラストタグ「#ななもこアート」をご利用いただけます。
          </p>
          <p>
            いただいたファンアートは、作者様のお名前やアカウントへのリンクとともに、当サイト、配信、SNS等で紹介させていただく場合があります。
          </p>
        </section>

        <section class="guideline-item">
          <h3>Generative AI and Machine Learning</h3>
          <p>
            七宝もこも・もここのキャラクターや設定を使用した、生成AIによる画像・動画等の作成および公開は禁止します。文章による指示だけで生成した場合も含みます。
          </p>
          <p>
            また、当サイトに掲載されているイラストやキャラクター資料を、生成AIを含む機械学習の学習データとして利用することも原則として禁止します。
          </p>
          <p>
            掲載作品について作者様が個別に方針を示している場合は、その方針にも従ってください。作者様の方針が確認できない場合や判断が難しい場合は、利用できません。
          </p>
          <p>
            掲載作品を使用した追加学習、モデル・LoRA等の作成、画像生成サービスへの入力、画像から画像を生成する機能への入力、作風や絵柄の模倣を目的とした利用も禁止します。
          </p>
        </section>
      </div>
    </section>

    <!-- Contact -->
    <section class="home-section contact-section">
      <h2>Contact</h2>

      <p>
        ご連絡・お問い合わせはこちらからお願いいたします。
      </p>

      <p lang="en">
        For inquiries, please use the contact form below.
      </p>

      <a
        class="contact-button"
        href={contactUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        お問い合わせ / Contact
      </a>
    </section>

  </main>

  <!-- Scheduleページと同じデザインのライトボックス -->
  <div
    id="schedule-lightbox"
    class="lightbox"
    aria-hidden="true"
  >
    <button
      class="lightbox-close"
      type="button"
      aria-label="閉じる"
    >
      ×
    </button>

    <button
      class="lightbox-prev"
      type="button"
      aria-label="前の画像"
    >
      ‹
    </button>

    <img
      class="lightbox-image"
      src=""
      alt=""
    />

    <button
      class="lightbox-next"
      type="button"
      aria-label="次の画像"
    >
      ›
    </button>
  </div>
</BaseLayout>

<script>
  const scheduleButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(
      '[data-schedule-index]'
    )
  );

  const lightbox =
    document.querySelector<HTMLDivElement>(
      '#schedule-lightbox'
    );

  const lightboxImage =
    lightbox?.querySelector<HTMLImageElement>(
      '.lightbox-image'
    );

  const closeButton =
    lightbox?.querySelector<HTMLButtonElement>(
      '.lightbox-close'
    );

  const prevButton =
    lightbox?.querySelector<HTMLButtonElement>(
      '.lightbox-prev'
    );

  const nextButton =
    lightbox?.querySelector<HTMLButtonElement>(
      '.lightbox-next'
    );

  let currentIndex = 0;

  function showImage(index: number) {
    if (!lightbox || !lightboxImage) return;
    if (scheduleButtons.length === 0) return;

    if (index < 0) {
      index = scheduleButtons.length - 1;
    }

    if (index >= scheduleButtons.length) {
      index = 0;
    }

    currentIndex = index;

    const button =
      scheduleButtons[currentIndex];

    const image =
      button.querySelector<HTMLImageElement>('img');

    if (!image) return;

    lightboxImage.setAttribute(
      'src',
      image.src
    );

    lightboxImage.setAttribute(
      'alt',
      image.alt
    );

    lightbox.classList.add('is-open');

    lightbox.setAttribute(
      'aria-hidden',
      'false'
    );

    document.body.classList.add(
      'lightbox-open'
    );
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImage) return;

    lightbox.classList.remove('is-open');

    lightbox.setAttribute(
      'aria-hidden',
      'true'
    );

    lightboxImage.setAttribute('src', '');

    document.body.classList.remove(
      'lightbox-open'
    );

    scheduleButtons[currentIndex]?.focus();
  }

  function showPrevious() {
    showImage(currentIndex - 1);
  }

  function showNext() {
    showImage(currentIndex + 1);
  }

  scheduleButtons.forEach((button, index) => {
    button.addEventListener('click', () => {
      showImage(index);
    });
  });

  closeButton?.addEventListener(
    'click',
    closeLightbox
  );

  prevButton?.addEventListener(
    'click',
    showPrevious
  );

  nextButton?.addEventListener(
    'click',
    showNext
  );

  lightbox?.addEventListener(
    'click',
    (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    }
  );

  document.addEventListener(
    'keydown',
    (event) => {
      if (
        !lightbox?.classList.contains(
          'is-open'
        )
      ) {
        return;
      }

      if (event.key === 'Escape') {
        closeLightbox();
      }

      if (event.key === 'ArrowLeft') {
        showPrevious();
      }

      if (event.key === 'ArrowRight') {
        showNext();
      }
    }
  );
</script>

<style>
  .home-page {
    width: min(100%, 1100px);
    margin: 0 auto;
  }

  /*
   * メインビジュアル
   */
  .hero {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 430px);
    gap: 3rem;
    align-items: center;

    min-height: 620px;
    padding: 2rem 0 4rem;
  }

  .hero-image {
    order: 2;

    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .hero-image img {
    display: block;

    width: 100%;
    max-width: 430px;
    max-height: 600px;

    object-fit: contain;
  }

  .hero-content {
    order: 1;
    min-width: 0;
  }

  .hero-content h1 {
    margin: 0 0 1.5rem;

    line-height: 1.15;
  }

  .name-ja,
  .name-en {
    display: block;
  }

  .name-ja {
    color: var(--color-text);

    font-size: clamp(2.7rem, 5.6vw, 4.6rem);
  }

  .name-en {
    margin-top: 0.5rem;

    color: var(--color-green-dark);

    font-size: clamp(1.45rem, 2.9vw, 2.1rem);
    font-weight: 600;
  }

  /*
   * HeroのSNSボタン
   */
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;

    margin-top: 1.75rem;
  }

  .hero-links a,
  .link-list a,
  .section-link a {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 44px;
    padding: 0.65rem 1.15rem;

    border: 1px solid var(--color-green);
    border-radius: 999px;

    background: #fff;
    color: var(--color-green-dark);

    font-weight: 600;
    line-height: 1.2;

    text-decoration: none;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }

  .hero-links a:hover,
  .link-list a:hover,
  .section-link a:hover {
    border-color: var(--color-green-dark);

    background: var(--color-green-soft);
    color: var(--color-green-dark);

    transform: translateY(-1px);
  }

  /*
   * メインビジュアルと
   * Latest Scheduleの区切り線
   */
  .hero-divider {
    width: 100%;
    height: 1px;
    margin: 0 0 3rem;

    background: var(--color-border);
  }
  
  /*
   * 各セクション共通
   */
  .home-section {
    margin: 0 0 5rem;

    scroll-margin-top: 2rem;
  }

  .home-section h2 {
    margin: 0 0 1.5rem;

    color: var(--color-text);

    font-size: 2rem;
  }

  /*
   * About
   */
  .about-card {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .about-introduction {
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .about-introduction p {
    margin: 0;
  }

  .about-introduction p + p {
    margin-top: 0.75rem;
  }

  .about-introduction p[lang="en"] {
    color: var(--color-text-soft);
  }

  .about-details {
    display: grid;
    gap: 0.8rem;
    margin: 0;
  }

  .about-details div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
  }

  .about-details dt {
    color: var(--color-green-dark);
    font-weight: 700;
  }

  .about-details dd {
    margin: 0;
  }

  /*
   * Latest Schedule
   */
  .schedule-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .schedule-card {
    display: block;

    width: 100%;
    padding: 0;

    border: 0;
    border-radius: 13px;

    background: #fff;

    font: inherit;

    cursor: zoom-in;
    overflow: hidden;

    transition:
      transform 0.15s ease;
  }

  .schedule-card img {
    display: block;

    width: 100%;
    height: auto;

    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .schedule-card:hover {
    transform: translateY(-2px);
  }

  .schedule-card:hover img {
    opacity: 0.96;
  }

  .section-link {
    margin-top: 1.25rem;

    text-align: center;
  }

  /*
   * Contents / Stores
   */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .info-card {
    position: relative;

    display: block;

    min-height: 150px;
    padding: 1.5rem 3.5rem 1.5rem 1.5rem;

    border: 1px solid var(--color-border);
    border-radius: 14px;

    background: #fff;
    color: var(--color-text);

    text-decoration: none;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .info-card:hover {
    border-color: var(--color-green);

    background: var(--color-green-soft);

    transform: translateY(-2px);
  }

  .info-card h3 {
    margin: 0 0 0.75rem;

    color: var(--color-green-dark);

    font-size: 1.2rem;
  }

  .info-card p {
    margin: 0;

    color: var(--color-text);

    line-height: 1.75;
  }

  .card-arrow {
    position: absolute;

    top: 1.5rem;
    right: 1.5rem;

    color: var(--color-green);

    font-size: 1.35rem;
    font-weight: 700;

    transition: transform 0.15s ease;
  }

  .info-card:hover .card-arrow {
    transform: translateX(3px);
  }

  /*
   * Links
   */
  .link-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /*
   * Guidelines
   */
  .guidelines-introduction {
    margin: 0;
    line-height: 1.8;
  }

  .guideline-item {
    margin-top: 2rem;
  }

  .guideline-item h3 {
    margin: 0 0 0.8rem;
    color: var(--color-green-dark);
    font-size: 1.2rem;
  }

  .guideline-item p {
    margin: 0;
    line-height: 1.8;
  }

  .guideline-item p + p {
    margin-top: 0.75rem;
  }

  .guideline-item ul {
    margin: 0.75rem 0 0;
    padding-left: 1.5rem;
  }

  .guideline-item li {
    margin-top: 0.4rem;
    line-height: 1.7;
  }

  /*
   * Contact
   */
  .contact-section p {
    margin: 0 0 0.5rem;

    line-height: 1.8;
  }

  .contact-section p[lang="en"] {
    color: var(--color-text-soft);
  }

  .contact-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 46px;
    margin-top: 1rem;
    padding: 0.7rem 1.3rem;

    border: 1px solid #628c3f;
    border-radius: 999px;

    background: #628c3f;
    color: #fff;

    font-weight: 700;
    line-height: 1.2;

    text-decoration: none;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .contact-button:hover {
    border-color: var(--color-green-dark);

    background: var(--color-green-dark);
    color: #fff;

    transform: translateY(-1px);
  }

  /*
   * ライトボックス全体
   *
   * Scheduleページと同じデザイン
   */
  .lightbox {
    position: fixed;

    inset: 0;

    z-index: 1000;

    display: none;

    align-items: center;
    justify-content: center;

    background:
      rgba(0, 0, 0, 0.88);

    padding: 3rem 5rem;
  }

  /*
   * 開いている状態
   */
  .lightbox.is-open {
    display: flex;
  }

  /*
   * 拡大画像
   */
  .lightbox-image {
    display: block;

    max-width: 90vw;
    max-height: 90vh;

    width: auto;
    height: auto;

    object-fit: contain;
  }

  /*
   * ライトボックスの共通ボタン
