---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeAbout from '../components/home/HomeAbout.astro';
import HomeGuidelines from '../components/home/HomeGuidelines.astro';
import MediaLightbox from '../components/MediaLightbox.astro';
import { withBase } from '../utils/paths';
import { getScheduleImages } from '../utils/media';
import { contactUrl } from '../data/links';

const schedules = getScheduleImages();

/*
 * Homeには最新2件だけ表示
 */
const latestSchedules = schedules.slice(0, 2);

const contents = [
  {
    title: 'References',
    description: '三面図などの資料を掲載しています！',
    href: '/references/',
  },
  {
    title: 'Illustrations',
    description:
      '頂いたファンアートやコミッションイラスト等をこちらでご紹介しています！',
    href: '/illustrations/',
  },
  {
    title: 'Archives',
    description:
      'YouTubeの配信アーカイブ、その他動画へのリンクです！ゲームタイトルで検索できます！',
    href: '/archives/',
  },
  {
    title: 'Works',
    description:
      '出演させていただいたゲーム作品等をこちらでご紹介しています！',
    href: '/works/',
  },
];

const stores = [
  {
    title: 'BOOTH',
    description: 'こちらでもこものグッズ販売をしています！',
    href: 'https://shippomokomo.booth.pm/',
  },
  {
    title: 'LINE Stickers',
    description:
      'もこも＆もここのLINEスタンプを公開しています！',
    href: 'https://store.line.me/stickershop/product/30400033/',
  },
];

const links = [
  {
    title: 'YouTube',
    href: 'https://www.youtube.com/@mokomo',
  },
  {
    title: 'X',
    href: 'https://x.com/shippomokomo',
  },
  {
    title: 'Bluesky',
    href: 'https://bsky.app/profile/shippomokomo.bsky.social',
  },
  {
    title: 'Instagram',
    href: 'https://www.instagram.com/shippomokomo/',
  },
  {
    title: 'VRoid Hub',
    href: 'https://hub.vroid.com/users/78987251',
  },
  {
    title: 'Amazon Wishlist',
    href: 'https://www.amazon.jp/hz/wishlist/ls/CF4UZ9QV6S35?ref_=wl_share',
  },
];

---

<BaseLayout title="Mokomo Games">
  <main class="home-page">

    <!-- メインビジュアル -->
    <section class="hero">
      <div class="hero-image">
        <img
          src={withBase('/images/home/main-visual.webp')}
          alt="七宝もこも / Shippo Mokomo"
        />
      </div>

      <div class="hero-content">
        <h1>
          <span class="name-ja">七宝もこも</span>
          <span class="name-en">Shippo Mokomo</span>
        </h1>

        <div class="hero-links">
          <a
            href="https://www.youtube.com/@mokomo"
            target="_blank"
            rel="noopener noreferrer"
          >
            YouTube
          </a>

          <a
            href="https://x.com/shippomokomo"
            target="_blank"
            rel="noopener noreferrer"
          >
            X
          </a>

          <a
            href="https://bsky.app/profile/shippomokomo.bsky.social"
            target="_blank"
            rel="noopener noreferrer"
          >
            Bluesky
          </a>
        </div>
      </div>
    </section>

    <!-- メインビジュアルとコンテンツの区切り線 -->
    <div class="hero-divider" aria-hidden="true"></div>

    <!-- About -->
    <section class="home-section about-section">
      <h2>About</h2>
      <HomeAbout />
    </section>

    <!-- Latest Schedule -->
    <section class="home-section">
      <h2>Latest Schedule</h2>

      {
        latestSchedules.length > 0 ? (
          <>
            <div class="schedule-grid">
              {latestSchedules.map((schedule, index) => (
                <button
                  class="schedule-card"
                  type="button"
                  data-schedule-index={index}
                  aria-label={`${schedule.dateLabel} のスケジュールを拡大表示`}
                >
                  <img
                    src={schedule.url}
                    alt={`${schedule.dateLabel} の配信スケジュール`}
                    loading="lazy"
                  />
                </button>
              ))}
            </div>

            <div class="section-link">
              <a href={withBase('/schedule/')}>
                過去のスケジュールを見る
              </a>
            </div>
          </>
        ) : (
          <p>現在掲載中のスケジュールはありません。</p>
        )
      }
    </section>

    <!-- Contents -->
    <section class="home-section">
      <h2>Contents</h2>

      <div class="card-grid">
        {
          contents.map((item) => (
            <a class="info-card" href={withBase(item.href)}>
              <h3>{item.title}</h3>
              <p>{item.description}</p>

              <span
                class="card-arrow"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Stores -->
    <section class="home-section">
      <h2>Stores</h2>

      <div class="card-grid store-grid">
        {
          stores.map((store) => (
            <a
              class="info-card"
              href={store.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <h3>{store.title}</h3>
              <p>{store.description}</p>

              <span
                class="card-arrow"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Links -->
    <section class="home-section">
      <h2>Links</h2>

      <div class="link-list">
        {
          links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.title}
            </a>
          ))
        }
      </div>
    </section>

    <!-- Guidelines -->
    <section class="home-section guidelines-section">
      <h2>Guidelines</h2>
      <HomeGuidelines />
    </section>

    <!-- Contact -->
    <section class="home-section contact-section">
      <h2>Contact</h2>

      <p>
        ご連絡・お問い合わせはこちらからお願いいたします。
      </p>

      <p lang="en">
        For inquiries, please use the contact form below.
      </p>

      <a
        class="contact-button"
        href={contactUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        お問い合わせ / Contact
      </a>
    </section>

  </main>

  <MediaLightbox id="schedule-lightbox" />
</BaseLayout>

<script>
  const scheduleButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(
      '[data-schedule-index]'
    )
  );

  const lightbox =
    document.querySelector<HTMLDivElement>(
      '#schedule-lightbox'
    );

  const lightboxImage =
    lightbox?.querySelector<HTMLImageElement>(
      '.lightbox-image'
    );

  const closeButton =
    lightbox?.querySelector<HTMLButtonElement>(
      '.lightbox-close'
    );

  const prevButton =
    lightbox?.querySelector<HTMLButtonElement>(
      '.lightbox-prev'
    );

  const nextButton =
    lightbox?.querySelector<HTMLButtonElement>(
      '.lightbox-next'
    );

  let currentIndex = 0;

  function showImage(index: number) {
    if (!lightbox || !lightboxImage) return;
    if (scheduleButtons.length === 0) return;

    if (index < 0) {
      index = scheduleButtons.length - 1;
    }

    if (index >= scheduleButtons.length) {
      index = 0;
    }

    currentIndex = index;

    const button =
      scheduleButtons[currentIndex];

    const image =
      button.querySelector<HTMLImageElement>('img');

    if (!image) return;

    lightboxImage.setAttribute(
      'src',
      image.src
    );

    lightboxImage.setAttribute(
      'alt',
      image.alt
    );

    lightbox.classList.add('is-open');

    lightbox.setAttribute(
      'aria-hidden',
      'false'
    );

    document.body.classList.add(
      'lightbox-open'
    );
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImage) return;

    lightbox.classList.remove('is-open');

    lightbox.setAttribute(
      'aria-hidden',
      'true'
    );

    lightboxImage.setAttribute('src', '');

    document.body.classList.remove(
      'lightbox-open'
    );

    scheduleButtons[currentIndex]?.focus();
  }

  function showPrevious() {
    showImage(currentIndex - 1);
  }

  function showNext() {
    showImage(currentIndex + 1);
  }

  scheduleButtons.forEach((button, index) => {
    button.addEventListener('click', () => {
      showImage(index);
    });
  });

  closeButton?.addEventListener(
    'click',
    closeLightbox
  );

  prevButton?.addEventListener(
    'click',
    showPrevious
  );

  nextButton?.addEventListener(
    'click',
    showNext
  );

  lightbox?.addEventListener(
    'click',
    (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    }
  );

  document.addEventListener(
    'keydown',
    (event) => {
      if (
        !lightbox?.classList.contains(
          'is-open'
        )
      ) {
        return;
      }

      if (event.key === 'Escape') {
        closeLightbox();
      }

      if (event.key === 'ArrowLeft') {
        showPrevious();
      }

      if (event.key === 'ArrowRight') {
        showNext();
      }
    }
  );
</script>

<style>
  .home-page {
    width: min(100%, 1100px);
    margin: 0 auto;
  }

  /*
   * メインビジュアル
   */
  .hero {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 430px);
    gap: 3rem;
    align-items: center;

    min-height: 620px;
    padding: 2rem 0 4rem;
  }

  .hero-image {
    order: 2;

    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .hero-image img {
    display: block;

    width: 100%;
    max-width: 430px;
    max-height: 600px;

    object-fit: contain;
  }

  .hero-content {
    order: 1;
    min-width: 0;
  }

  .hero-content h1 {
    margin: 0 0 1.5rem;

    line-height: 1.15;
  }

  .name-ja,
  .name-en {
    display: block;
  }

  .name-ja {
    color: var(--color-text);

    font-size: clamp(2.7rem, 5.6vw, 4.6rem);
  }

  .name-en {
    margin-top: 0.5rem;

    color: var(--color-green-dark);

    font-size: clamp(1.45rem, 2.9vw, 2.1rem);
    font-weight: 600;
  }

  /*
   * HeroのSNSボタン
   */
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;

    margin-top: 1.75rem;
  }

  .hero-links a,
  .link-list a,
  .section-link a {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 44px;
    padding: 0.65rem 1.15rem;

    border: 1px solid var(--color-green);
    border-radius: 999px;

    background: #fff;
    color: var(--color-green-dark);

    font-weight: 600;
    line-height: 1.2;

    text-decoration: none;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }

  .hero-links a:hover,
  .link-list a:hover,
  .section-link a:hover {
    border-color: var(--color-green-dark);

    background: var(--color-green-soft);
    color: var(--color-green-dark);

    transform: translateY(-1px);
  }

  /*
   * メインビジュアルと
   * Latest Scheduleの区切り線
   */
  .hero-divider {
    width: 100%;
    height: 1px;
    margin: 0 0 3rem;

    background: var(--color-border);
  }
  
  /*
   * 各セクション共通
   */
  .home-section {
    margin: 0 0 5rem;

    scroll-margin-top: 2rem;
  }

  .home-section h2 {
    margin: 0 0 1.5rem;

    color: var(--color-text);

    font-size: 2rem;
  }

  /*
   * Latest Schedule
   */
  .schedule-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .schedule-card {
    display: block;

    width: 100%;
    padding: 0;

    border: 0;
    border-radius: 13px;

    background: #fff;

    font: inherit;

    cursor: zoom-in;
    overflow: hidden;

    transition:
      transform 0.15s ease;
  }

  .schedule-card img {
    display: block;

    width: 100%;
    height: auto;

    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .schedule-card:hover {
    transform: translateY(-2px);
  }

  .schedule-card:hover img {
    opacity: 0.96;
  }

  .section-link {
    margin-top: 1.25rem;

    text-align: center;
  }

  /*
   * Contents / Stores
   */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .info-card {
    position: relative;

    display: block;

    min-height: 150px;
    padding: 1.5rem 3.5rem 1.5rem 1.5rem;

    border: 1px solid var(--color-border);
    border-radius: 14px;

    background: #fff;
    color: var(--color-text);

    text-decoration: none;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .info-card:hover {
    border-color: var(--color-green);

    background: var(--color-green-soft);

    transform: translateY(-2px);
  }

  .info-card h3 {
    margin: 0 0 0.75rem;

    color: var(--color-green-dark);

    font-size: 1.2rem;
  }

  .info-card p {
    margin: 0;

    color: var(--color-text);

    line-height: 1.75;
  }

  .card-arrow {
    position: absolute;

    top: 1.5rem;
    right: 1.5rem;

    color: var(--color-green);

    font-size: 1.35rem;
    font-weight: 700;

    transition: transform 0.15s ease;
  }

  .info-card:hover .card-arrow {
    transform: translateX(3px);
  }

  /*
   * Links
   */
  .link-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /*
   * Contact
   */
  .contact-section p {
    margin: 0 0 0.5rem;

    line-height: 1.8;
  }

  .contact-section p[lang="en"] {
    color: var(--color-text-soft);
  }

  .contact-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 46px;
    margin-top: 1rem;
    padding: 0.7rem 1.3rem;

    border: 1px solid #628c3f;
    border-radius: 999px;

    background: #628c3f;
    color: #fff;

    font-weight: 700;
    line-height: 1.2;

    text-decoration: none;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .contact-button:hover {
    border-color: var(--color-green-dark);

    background: var(--color-green-dark);
    color: #fff;

    transform: translateY(-1px);
  }


  /*
   * スマートフォン
   */
  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;

      min-height: 0;
      padding: 1.5rem 0 3.5rem;
    }

    .hero-image {
      order: 1;
    }

    .hero-content {
      order: 2;

      text-align: center;
    }

    .hero-image img {
      max-width: 320px;
      max-height: 480px;
    }

    .hero-links {
      justify-content: center;
    }

    .home-section {
      margin-bottom: 4rem;
    }

    .home-section h2 {
      font-size: 1.7rem;
    }

    .schedule-grid,
    .card-grid {
      grid-template-columns: 1fr;
    }

    .link-list {
      justify-content: flex-start;
    }

  }
</style>
