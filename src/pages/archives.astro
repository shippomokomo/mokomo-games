---
import BaseLayout from '../layouts/BaseLayout.astro';
import { archiveCategories } from '../data/archives';
import { allGroups, groups } from '../utils/archiveGroups';



---

<BaseLayout
  title="Archives | Mokomo Games"
  description="七宝もこものYouTube配信アーカイブや動画を、ゲームタイトルから検索できます。"
>
  <h1>Archives</h1>

  <div class="archives-page">
    <nav
      class="archive-categories"
      aria-label="Archive categories"
    >
      {archiveCategories.map((category) => (
        <a
          href={category.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {category.title}
        </a>
      ))}
    </nav>

    <section class="games-section">
      <h2>Games</h2>

      <p class="archive-note">
        一部、近日実況配信予定のものも含まれます。
      </p>

      <p class="sponsored-note">
        ★：デベロッパー様、パブリッシャー様のご依頼により
        実況配信したタイトル
      </p>

      <div class="search-area">
        <label for="game-search">
          ゲームタイトルを検索
        </label>

        <div class="search-row">
          <input
            id="game-search"
            class="game-search"
            type="search"
            placeholder="例：Outer Wilds"
            autocomplete="off"
          />

          <button
            type="button"
            class="search-clear"
            hidden
          >
            クリア
          </button>
        </div>
      </div>

      <!-- 頭文字から探す -->
      <nav
        class="initial-index"
        aria-label="ゲームタイトルの頭文字から探す"
      >
        <span class="initial-index-label">
          頭文字から探す
        </span>

        <div class="initial-index-links">
          {allGroups.map((group) => (
            group.games.length > 0 ? (
              <a href={`#group-${group.name}`}>
                {group.name === 'その他' ? '他' : group.name}
              </a>
            ) : (
              <span class="initial-index-unavailable" aria-disabled="true">
                {group.name === 'その他' ? '他' : group.name}
              </span>
            )
          ))}
        </div>
      </nav>
      
      <p
        class="search-result-count"
        aria-live="polite"
      ></p>

      <p
        class="no-results"
        hidden
      >
        該当するタイトルはありません。
      </p>

      <div class="archive-grid">
        {groups.map((group) => (
          <section
            id={`group-${group.name}`}
            class="archive-group"
            data-group={group.name}
          >
            <h3>{group.name}</h3>

            <ul>
              {group.games.map((game) => (
                <li
                  class="game-item"
                  data-title={game.title}
                  data-reading={
                    'reading' in game
                      ? game.reading
                      : ''
                  }
                >
                  {
                    'sponsored' in game &&
                    game.sponsored && (
                      <span
                        class="sponsored-star"
                        aria-label="依頼による実況配信"
                        title="デベロッパー様、パブリッシャー様のご依頼による実況配信"
                      >
                        ★
                      </span>
                    )
                  }

                  {
                    game.url ? (
                      <a
                        href={game.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {game.title}
                      </a>
                    ) : (
                      <span class="no-link">
                        {game.title}
                      </span>
                    )
                  }
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
  </div>

  <script>
    const searchInput =
      document.querySelector<HTMLInputElement>(
        '#game-search'
      );

    const clearButton =
      document.querySelector<HTMLButtonElement>(
        '.search-clear'
      );

    const gameItems = Array.from(
      document.querySelectorAll<HTMLElement>(
        '.game-item'
      )
    );

    const archiveGroups = Array.from(
      document.querySelectorAll<HTMLElement>(
        '.archive-group'
      )
    );

    const noResults =
      document.querySelector<HTMLElement>(
        '.no-results'
      );

    const resultCount =
      document.querySelector<HTMLElement>(
        '.search-result-count'
      );

    function normalizeText(text: string) {
      return text
        .normalize('NFKC')
        .toLowerCase()
        .replace(/\s+/g, ' ')
        .trim();
    }

    function updateSearch() {
      if (!searchInput) return;

      const query =
        normalizeText(searchInput.value);

      let visibleCount = 0;

      gameItems.forEach((item) => {
        const title =
          normalizeText(
            item.dataset.title ?? ''
          );

        const reading =
          normalizeText(
            item.dataset.reading ?? ''
          );

        const shouldShow =
          query === '' ||
          title.includes(query) ||
          reading.includes(query);

        item.hidden = !shouldShow;

        if (shouldShow) {
          visibleCount += 1;
        }
      });

      archiveGroups.forEach((group) => {
        const visibleItems =
          group.querySelectorAll(
            '.game-item:not([hidden])'
          );

        group.hidden =
          visibleItems.length === 0;
      });

      if (clearButton) {
        clearButton.hidden =
          searchInput.value.length === 0;
      }

      if (noResults) {
        noResults.hidden =
          query === '' ||
          visibleCount !== 0;
      }

      if (resultCount) {
        if (
          query === '' ||
          visibleCount === 0
        ) {
          resultCount.textContent = '';
        } else {
          resultCount.textContent =
            `${visibleCount}件見つかりました`;
        }
      }
    }

    searchInput?.addEventListener(
      'input',
      updateSearch
    );

    clearButton?.addEventListener(
      'click',
      () => {
        if (!searchInput) return;

        searchInput.value = '';

        updateSearch();
        searchInput.focus();
      }
    );

    updateSearch();
  </script>
</BaseLayout>

<style>
  .archives-page {
    max-width: 1400px;
    margin: 0 auto;
  }

  /*
   * Archiveカテゴリ
   *
   * Homeのリンクボタンと同じ
   * 白地＋緑枠のデザイン
   */
  .archive-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;

    margin-bottom: 3rem;
  }

  .archive-categories a {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 44px;
    padding: 0.65rem 1.15rem;

    border: 1px solid var(--color-green);
    border-radius: 999px;

    background: #fff;
    color: var(--color-green-dark);

    font-weight: 600;
    line-height: 1.2;

    text-decoration: none;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }

  .archive-categories a:hover {
    border-color: var(--color-green-dark);

    background: var(--color-green-soft);
    color: var(--color-green-dark);

    transform: translateY(-1px);
  }

  /*
   * Games
   */
  .games-section h2 {
    margin-bottom: 0.75rem;
  }

  .archive-note,
  .sponsored-note {
    margin: 0.4rem 0;

    color: var(--color-text-soft);

    line-height: 1.7;
  }

  /*
   * ★
   */
  .sponsored-star {
    margin-right: 0.2rem;

    color: var(--color-green-dark);

    font-weight: 700;
  }

  /*
   * 検索
   */
  .search-area {
    max-width: 700px;

    margin: 2rem 0 0.5rem;
  }

  .search-area label {
    display: block;

    margin-bottom: 0.5rem;

    color: var(--color-text);

    font-weight: 700;
  }

  .search-row {
    display: flex;
    gap: 0.75rem;
  }

  /*
   * 検索入力欄
   */
  .game-search {
    width: 100%;
    min-width: 0;

    padding: 0.75rem 1rem;

    border: 1px solid var(--color-border);
    border-radius: 10px;

    background: #fff;
    color: var(--color-text);

    font: inherit;

    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .game-search:hover {
    border-color: var(--color-green);
  }

  .game-search:focus {
    border-color: var(--color-green);

    outline: none;

    box-shadow:
      0 0 0 3px var(--color-green-soft);
  }

  /*
   * クリアボタン
   */
  .search-clear {
    flex: 0 0 auto;

    padding: 0.6rem 1rem;

    border: 1px solid var(--color-green);
    border-radius: 10px;

    background: #fff;
    color: var(--color-green-dark);

    font: inherit;
    font-weight: 600;

    cursor: pointer;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .search-clear:hover {
    border-color: var(--color-green-dark);

    background: var(--color-green-soft);
    color: var(--color-green-dark);
  }

  .search-clear[hidden] {
    display: none;
  }

  /*
   * 頭文字から探す
   */
  .initial-index {
    max-width: 900px;

    margin: 1.5rem 0 0;
  }

  .initial-index-label {
    display: block;

    margin-bottom: 0.65rem;

    color: var(--color-text);

    font-weight: 700;
  }

  .initial-index-links {
    display: flex;
    flex-wrap: wrap;

    gap: 0.45rem;
  }

  .initial-index-links a,
  .initial-index-links span {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 3rem;
    min-height: 2.4rem;
    box-sizing: border-box;

    padding: 0.35rem 0.6rem;

    border: 1px solid var(--color-border);
    border-radius: 8px;

    background: transparent;
    color: var(--color-green-dark);

    font-weight: 700;
    line-height: 1;

    text-decoration: none;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .initial-index-unavailable {
    opacity: 0.4;
    cursor: default;
  }

  .initial-index-links a:hover {
    border-color: var(--color-green);

    background: var(--color-green-soft);
    color: var(--color-green-dark);
  }

  /*
   * 頭文字を押してジャンプしたとき、
   * 見出しが画面上端にくっつきすぎないようにする
   */
  .archive-group {
    scroll-margin-top: 2rem;
  }
  
  /*
   * 検索結果
   */
  .search-result-count {
    min-height: 1.5em;

    margin: 0.5rem 0 1.5rem;

    color: var(--color-green-dark);

    font-size: 0.9rem;
    font-weight: 600;
  }

  .no-results {
    margin: 2rem 0;

    color: var(--color-text-soft);
  }

  .no-results[hidden] {
    display: none;
  }

  /*
   * ゲーム一覧
   */
  .archive-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 2.5rem 3rem;

    align-items: start;

    margin-top: 1rem;
  }

  .archive-group {
    min-width: 0;
  }

  .archive-group[hidden] {
    display: none;
  }

  /*
   * A / B / C / あ / か...
   */
  .archive-group h3 {
    margin: 0 0 0.8rem;
    padding-bottom: 0.4rem;

    border-bottom:
      1px solid var(--color-border);

    color: var(--color-green-dark);

    font-size: 1.5rem;
  }

  .archive-group ul {
    margin: 0;
    padding: 0;

    list-style: none;
  }

  /*
   * ゲームタイトル
   */
  .game-item {
    margin: 0.55rem 0;

    line-height: 1.5;

    overflow-wrap: anywhere;
  }

  .game-item[hidden] {
    display: none;
  }

  .game-item a {
    color: var(--color-text);

    text-decoration-color:
      var(--color-border);

    text-underline-offset: 0.18em;

    transition:
      color 0.15s ease,
      text-decoration-color 0.15s ease;
  }

  .game-item a:hover {
    color: var(--color-green-dark);

    text-decoration-color:
      var(--color-green);

    text-decoration-thickness: 2px;
  }

  /*
   * リンクがないタイトル
   */
  .no-link {
    color: var(--color-text-soft);
  }

  /*
   * タブレット
   */
  @media (max-width: 1000px) {
    .archive-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  /*
   * スマートフォン
   */
  @media (max-width: 700px) {
    .archive-categories {
      gap: 0.6rem;
    }

    .archive-categories a {
      min-height: 40px;

      padding: 0.55rem 0.9rem;

      font-size: 0.9rem;
    }

    .search-row {
      align-items: stretch;
    }

    .archive-grid {
      grid-template-columns: 1fr;

      gap: 2rem;
    }
  }
</style>
