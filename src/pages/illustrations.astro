---
import { readFile } from 'node:fs/promises';
import { imageMetadata } from 'astro/assets/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/illustrations.css';
import MediaLightbox from '../components/MediaLightbox.astro';
import { getIllustrationMedia } from '../utils/media';

// Read dimensions at build time; original media and browser lazy loading stay intact.
const illustrations = await Promise.all(getIllustrationMedia().map(async (item) => {
  if (item.isVideo) return { ...item, width: undefined, height: undefined };
  const path = 'public/images/illustrations/' + item.filename;
  const { width, height } = await imageMetadata(await readFile(path), item.filename);
  return { ...item, width, height };
}));
---

<BaseLayout
  title="Illustrations | Mokomo Games"
  description="七宝もこも・もここのファンアートやコミッションイラストをご紹介しています。作者名やキャラクターから作品を探せます。"
>
  <h1>Illustrations</h1>

  <div class="filters">
    <div class="filter-group">
      <span class="filter-label">Type</span>

      <div class="filter-buttons">
        <button
          type="button"
          class="filter-button is-active"
          data-filter-type="all"
          aria-pressed="true"
        >
          All
        </button>

        <button
          type="button"
          class="filter-button"
          data-filter-type="fanart"
          aria-pressed="false"
        >
          Fanart
        </button>

        <button
          type="button"
          class="filter-button"
          data-filter-type="commission"
          aria-pressed="false"
        >
          Commission
        </button>
      </div>
    </div>

    <div class="filter-group">
      <span class="filter-label">Character</span>

      <div class="filter-buttons">
        <button
          type="button"
          class="filter-button is-active"
          data-filter-character="all"
          aria-pressed="true"
        >
          All
        </button>

        <button
          type="button"
          class="filter-button"
          data-filter-character="mokomo"
          aria-pressed="false"
        >
          Mokomo
        </button>

        <button
          type="button"
          class="filter-button"
          data-filter-character="mokoko"
          aria-pressed="false"
        >
          Mokoko
        </button>
      </div>
    </div>

    <div class="filter-group">
      <label class="filter-label" for="artist-search">作者を検索</label>
      <input
        id="artist-search"
        class="artist-search"
        type="search"
        placeholder="例：きくり"
        autocomplete="off"
      />
    </div>

    <div class="artist-filter" hidden>
      <span>
        作者：
        <strong class="artist-filter-name"></strong>
        さん
      </span>

      <button
        type="button"
        class="artist-filter-clear"
      >
        作者の絞り込みを解除
      </button>
    </div>
  </div>

  <p class="result-count" role="status" aria-live="polite"><span class="result-count-value">{illustrations.length}</span>件</p>

  <p class="no-results" hidden>
    条件に一致するイラストはありません。
  </p>

  <div class="illustration-grid">
    {illustrations.map((illustration) => (
      <article
        class="illustration-item"
        data-type={illustration.type}
        data-character={illustration.character}
        data-artist={illustration.artistId}
        data-artist-name={illustration.artist?.name ?? illustration.artistId}
      >
        <div class="illustration-media">
          {illustration.isVideo ? (
            <>
              <video class="illustration-image illustration-video" data-lightbox-trigger data-full={illustration.url} preload="none" muted playsinline tabindex="0" aria-label={illustration.artist ? `${illustration.artist.name}さんの動画` : '動画'}></video>
              <span class="video-play" aria-hidden="true">▶</span>
            </>
          ) : (
            <img width={illustration.width} height={illustration.height} class="illustration-image" data-lightbox-trigger src={illustration.url} data-full={illustration.url} alt={illustration.artist ? `${illustration.artist.name}さんのイラスト` : 'イラスト'} loading="lazy" tabindex="0" />
          )}
        </div>

        <div class="illustration-info">
          {illustration.artist ? (
            <>
          {illustration.artist.url ? (
            <a
              class="artist-link"
              href={illustration.artist.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {illustration.artist.name}さん
            </a>
          ) : (
            <span class="artist-name">
              {illustration.artist.name}さん
            </span>
          )}

              <button
                type="button"
                class="artist-filter-button"
                data-artist-id={illustration.artistId}
                data-artist-name={illustration.artist.name}
              >
                作品を見る
              </button>
            </>
          ) : (
            <span>{illustration.artistId}</span>
          )}
        </div>
      </article>
    ))}
  </div>

  <MediaLightbox id="lightbox" includeVideo />

  <script src="../scripts/illustrations.ts"></script>
</BaseLayout>
