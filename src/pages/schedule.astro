---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaLightbox from '../components/MediaLightbox.astro';
import { getScheduleImages, type ScheduleImage } from '../utils/media';

const schedules = getScheduleImages();


// 年ごとに分類
const grouped = schedules.reduce<Record<number, ScheduleImage[]>>((acc, schedule) => {
  const year = schedule.year;

  if (!acc[year]) {
    acc[year] = [];
  }

  acc[year].push(schedule);

  return acc;
}, {});


// 年を新しい順に並べる
const years = Object.keys(grouped)
  .map(Number)
  .sort((a, b) => b - a);


// 一番新しい年
const latestYear = years[0];
---

<BaseLayout title="Schedule | Mokomo Games">

  <h1>Schedule</h1>

  <div class="year-list">

    {years.map((year) => (

      <details open={year === latestYear}>

        <summary>
          {year}
        </summary>

        <div class="schedule-grid">

          {grouped[year].map((schedule) => (

            <article class="schedule-item">

              <img
                src={year === latestYear ? schedule.url : undefined}
                data-src={year === latestYear ? undefined : schedule.url}
                data-full={schedule.url}
                alt={`${schedule.dateLabel} の配信スケジュール`}
                loading="lazy"
                tabindex="0"
              />

            </article>

          ))}

        </div>

      </details>

    ))}

  </div>


  <MediaLightbox id="lightbox" />


  <script>

    /*
     * 過去年の画像は、
     * 年を開いたときに初めて読み込む
     */

    document.querySelectorAll('details').forEach((details) => {

      details.addEventListener('toggle', () => {

        if (!details.open) return;

        details.querySelectorAll('img[data-src]').forEach((img) => {

          const src = img.getAttribute('data-src');

          if (src) {
            img.setAttribute('src', src);
            img.removeAttribute('data-src');
          }

        });

      });

    });


    /*
     * ライトボックス
     */

    const scheduleImages =
      Array.from(
        document.querySelectorAll('.schedule-item img')
      );

    const lightbox =
      document.querySelector('#lightbox');

    const lightboxImage =
      document.querySelector('.lightbox-image');

    const closeButton =
      document.querySelector('.lightbox-close');

    const prevButton =
      document.querySelector('.lightbox-prev');

    const nextButton =
      document.querySelector('.lightbox-next');

    let currentIndex = 0;


    /*
     * 指定した画像を拡大表示
     */

    function showImage(index) {

      if (!lightbox || !lightboxImage) return;

      if (index < 0) {
        index = scheduleImages.length - 1;
      }

      if (index >= scheduleImages.length) {
        index = 0;
      }

      currentIndex = index;

      const image = scheduleImages[currentIndex];

      const fullSrc =
        image.getAttribute('data-full');

      if (!fullSrc) return;

      lightboxImage.setAttribute('src', fullSrc);

      lightboxImage.setAttribute(
        'alt',
        image.getAttribute('alt') ?? ''
      );

      lightbox.classList.add('is-open');

      lightbox.setAttribute(
        'aria-hidden',
        'false'
      );

      document.body.classList.add(
        'lightbox-open'
      );

    }


    /*
     * ライトボックスを閉じる
     */

    function closeLightbox() {

      if (!lightbox || !lightboxImage) return;

      lightbox.classList.remove('is-open');

      lightbox.setAttribute(
        'aria-hidden',
        'true'
      );

      lightboxImage.setAttribute('src', '');

      document.body.classList.remove(
        'lightbox-open'
      );

    }


    /*
     * 前の画像
     */

    function showPrevious() {
      showImage(currentIndex - 1);
    }


    /*
     * 次の画像
     */

    function showNext() {
      showImage(currentIndex + 1);
    }


    /*
     * 通常画像をクリック
     */

    scheduleImages.forEach((image, index) => {

      image.addEventListener('click', () => {
        showImage(index);
      });


      /*
       * Enterキーでも開ける
       */

      image.addEventListener(
        'keydown',
        (event) => {

          if (
            event.key === 'Enter' ||
            event.key === ' '
          ) {
            event.preventDefault();
            showImage(index);
          }

        }
      );

    });


    /*
     * ボタン
     */

    closeButton?.addEventListener(
      'click',
      closeLightbox
    );

    prevButton?.addEventListener(
      'click',
      showPrevious
    );

    nextButton?.addEventListener(
      'click',
      showNext
    );


    /*
     * 背景をクリックした場合も閉じる
     */

    lightbox?.addEventListener(
      'click',
      (event) => {

        if (event.target === lightbox) {
          closeLightbox();
        }

      }
    );


    /*
     * キーボード操作
     *
     * ← 前
     * → 次
     * Esc 閉じる
     */

    document.addEventListener(
      'keydown',
      (event) => {

        if (
          !lightbox?.classList.contains(
            'is-open'
          )
        ) {
          return;
        }

        if (event.key === 'Escape') {
          closeLightbox();
        }

        if (event.key === 'ArrowLeft') {
          showPrevious();
        }

        if (event.key === 'ArrowRight') {
          showNext();
        }

      }
    );

  </script>

</BaseLayout>

<style>
  /*
   * 年ごとの一覧
   */
  .year-list {
    display: grid;
    gap: 1rem;

    max-width: 1400px;
    margin: 0 auto;
  }

  /*
   * 年ごとのまとまり
   *
   * 白いカードや外枠は付けず、
   * ページ背景に直接配置
   */
  details {
    background: transparent;
  }

  /*
   * 2026、2025... の部分
   *
   * 開いていても閉じていても
   * 同じデザインにする
   */
  summary {
    cursor: pointer;

    list-style: none;

    padding: 1rem 0;

    border-bottom:
      1px solid var(--color-border);

    background: transparent;
    color: var(--color-green-dark);

    font-size: 1.4rem;
    font-weight: 700;

    user-select: none;

    transition:
      color 0.15s ease;
  }

  summary:hover {
    color: var(--color-green);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /*
   * ▶ マーク
   */
  summary::before {
    content: "▶";

    display: inline-block;

    margin-right: 0.7rem;

    color: var(--color-green);

    font-size: 0.85rem;

    transition:
      transform 0.2s ease;
  }

  /*
   * 開いたときに回転
   */
  details[open] summary::before {
    transform: rotate(90deg);
  }

  /*
   * スケジュール画像一覧
   *
   * 白い外枠を使わず、
   * ページ背景へ直接並べる
   */
  .schedule-grid {
    display: grid;

    grid-template-columns:
      repeat(auto-fit, minmax(300px, 1fr));

    gap: 1.5rem;

    padding: 1.5rem 0 0;
  }

  .schedule-item {
    width: 100%;
  }

  /*
   * 通常の画像
   *
   * 他ページと同じく枠線なし
   */
  .schedule-item img {
    display: block;

    width: 100%;
    height: auto;

    border-radius: 10px;

    cursor: zoom-in;

    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  /*
   * マウスを乗せたとき
   */
  .schedule-item img:hover {
    transform: scale(1.01);

    opacity: 0.96;
  }


  /*
   * スマートフォン
   */
  @media (max-width: 700px) {
    .year-list {
      gap: 0.8rem;
    }

    summary {
      padding: 0.9rem 0;

      font-size: 1.2rem;
    }

    .schedule-grid {
      grid-template-columns: 1fr;

      gap: 1rem;

      padding: 1rem 0 0;
    }

    .schedule-item img {
      border-radius: 8px;
    }

  }
</style>
