---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
import { workSections } from '../data/works';
---

<BaseLayout
  title="Works | Mokomo Games"
  description="七宝もこもの出演作品、インタビュー、制作したゲームMODなどをご紹介しています。"
>
  <main class="works-page">
    <h1>Works</h1>

    <p class="intro">
      もこもが出演させていただいた作品等をこちらでご紹介しています！
    </p>

    <nav class="works-nav" aria-label="Works categories">
      {
        workSections.map((section) => (
          <a href={`#${section.id}`}>{section.title}</a>
        ))
      }
    </nav>

    {
      workSections.map((section) => (
        <section class="works-section" id={section.id}>
          <h2>{section.title}</h2>

          <div class="works-list">
            {section.works.map((work) => (
              <details class="work-card">
                <summary>
                  <div class="work-summary">
                    <img
                      src={withBase(`/images/works/${work.image}`)}
                      alt=""
                      loading="lazy"
                    />

                    <div class="work-summary-text">
                      <h3>{work.title}</h3>

                      <p>{work.description}</p>

                      <span class="open-label">
                        <span class="open-text">詳細を見る</span>
                        <span class="close-text">閉じる</span>
                        <span class="arrow" aria-hidden="true">▼</span>
                      </span>
                    </div>
                  </div>
                </summary>

                <div class="work-details">
                  <div class="work-links">
                    {work.links.map((link) => (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>

                  {'notice' in work && work.notice && (
                    <p class="notice">{work.notice}</p>
                  )}
                </div>
              </details>
            ))}
          </div>
        </section>
      ))
    }
  </main>
</BaseLayout>

<style>
  .works-page {
    width: min(100%, 960px);
    margin: 0 auto;
  }

  .works-page h1 {
    margin-bottom: 0.5rem;
  }

  /*
   * ページ冒頭
   */
  .intro {
    margin: 0 0 1.5rem;

    color: var(--color-text-soft);

    line-height: 1.8;
  }

  /*
   * Interviews / Games / MODs
   */
  .works-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;

    margin-bottom: 3rem;
  }

  .works-nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 44px;
    padding: 0.65rem 1.15rem;

    border: 1px solid var(--color-green);
    border-radius: 999px;

    background: #fff;
    color: var(--color-green-dark);

    font-weight: 600;
    line-height: 1.2;

    text-decoration: none;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }

  .works-nav a:hover {
    border-color: var(--color-green-dark);

    background: var(--color-green-soft);
    color: var(--color-green-dark);

    transform: translateY(-1px);
  }

  /*
   * カテゴリ
   */
  .works-section {
    margin-bottom: 4rem;

    scroll-margin-top: 2rem;
  }

  .works-section h2 {
    margin: 0 0 1.25rem;

    color: var(--color-text);

    font-size: 2rem;
  }

  /*
   * 作品一覧
   */
  .works-list {
    display: grid;
    gap: 1rem;
  }

  /*
   * 作品カード
   */
  .work-card {
    overflow: hidden;

    border: 1px solid var(--color-border);
    border-radius: 14px;

    background: #fff;

    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .work-card:hover {
    border-color: var(--color-green);
  }

  .work-card[open] {
    border-color: var(--color-green);
  }

  /*
   * カード上部
   */
  .work-card summary {
    display: block;

    cursor: pointer;
    list-style: none;

    transition: background-color 0.15s ease;
  }

  .work-card summary:hover {
    background: var(--color-green-soft);
  }

  .work-card[open] summary {
    background: #fff;
  }

  .work-card[open] summary:hover {
    background: var(--color-green-soft);
  }

  .work-card summary::-webkit-details-marker {
    display: none;
  }

  /*
   * 画像＋説明
   */
  .work-summary {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 1.5rem;
    align-items: center;

    padding: 1rem;
  }

  /*
   * 作品画像
   *
   * 画像自体には枠線を付けない
   */
  .work-summary img {
    display: block;

    width: 100%;
    height: auto;

    border-radius: 8px;
  }

  .work-summary-text {
    min-width: 0;
  }

  /*
   * 作品タイトル
   */
  .work-summary-text h3 {
    margin: 0 0 0.75rem;

    color: var(--color-green-dark);

    font-size: 1.15rem;
    line-height: 1.5;
  }

  /*
   * 作品説明
   */
  .work-summary-text p {
    margin: 0;

    color: var(--color-text);

    line-height: 1.75;
  }

  /*
   * 詳細を見る / 閉じる
   */
  .open-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;

    margin-top: 1rem;

    color: var(--color-green-dark);

    font-size: 0.9rem;
    font-weight: 700;
  }

  .arrow {
    display: inline-block;

    color: var(--color-green);

    font-size: 0.7rem;

    transition: transform 0.2s ease;
  }

  .close-text {
    display: none;
  }

  .work-card[open] .open-text {
    display: none;
  }

  .work-card[open] .close-text {
    display: inline;
  }

  .work-card[open] .arrow {
    transform: rotate(180deg);
  }

  /*
   * 開いた部分
   */
  .work-details {
    margin: 0 1rem;
    padding: 0 0 1.25rem;

    border-top: 1px solid var(--color-border);
  }

  /*
   * 外部リンク
   */
  .work-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;

    margin-top: 1.25rem;
  }

  .work-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 42px;
    padding: 0.6rem 0.9rem;

    border: 1px solid var(--color-green);
    border-radius: 999px;

    background: #fff;
    color: var(--color-green-dark);

    font-weight: 600;
    line-height: 1.2;

    text-decoration: none;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }

  .work-links a:hover {
    border-color: var(--color-green-dark);

    background: var(--color-green-soft);
    color: var(--color-green-dark);

    transform: translateY(-1px);
  }

  /*
   * 注意書き
   */
  .notice {
    margin: 1rem 0 0;

    color: var(--color-text-soft);

    font-size: 0.9rem;
    line-height: 1.7;
  }

  /*
   * スマートフォン
   */
  @media (max-width: 700px) {
    .works-nav {
      margin-bottom: 2.5rem;
    }

    .works-nav a {
      min-height: 40px;

      padding: 0.55rem 0.9rem;

      font-size: 0.9rem;
    }

    .works-section {
      margin-bottom: 3rem;
    }

    .works-section h2 {
      font-size: 1.7rem;
    }

    /*
     * スマホでは
     * 画像→文章の1列
     */
    .work-summary {
      grid-template-columns: 1fr;

      gap: 1rem;
    }

    .work-summary img {
      max-height: 360px;

      object-fit: contain;
    }

    .work-details {
      margin: 0 1rem;
    }
  }
</style>
