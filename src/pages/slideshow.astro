---
import { readdirSync } from 'node:fs';
import { withBase } from '../utils/paths';
import { artists } from '../data/artists';

const slideshowItems = readdirSync('public/images/illustrations')
  .filter((filename) => filename.toLowerCase().endsWith('.webp'))
  .sort((a, b) => a.localeCompare(b, 'en'))
  .map((filename) => {
    const artistId = filename.match(/^([a-z0-9]+)_/i)?.[1]?.toLowerCase() ?? '';
    const artist = artists[artistId as keyof typeof artists];

    return {
      url: withBase(`/images/illustrations/${encodeURIComponent(filename)}`),
      artistName: artist?.name ?? artistId,
    };
  });
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@700&display=swap"
      rel="stylesheet"
    />
    <title>Illustration Slideshow | Mokomo Games</title>
  </head>
  <body>
    <main class="slideshow" aria-label="イラストスライドショー">
      <figure class="slide is-visible">
        <img class="slide-image" alt="" />
        <figcaption class="artist-name"></figcaption>
      </figure>
      <figure class="slide">
        <img class="slide-image" alt="" />
        <figcaption class="artist-name"></figcaption>
      </figure>
      <p class="empty-message" hidden>表示できるWebP画像がありません。</p>
    </main>

    <script define:vars={{ slideshowItems }}>
      const slides = Array.from(document.querySelectorAll('.slide'));
      const emptyMessage = document.querySelector('.empty-message');
      const params = new URLSearchParams(window.location.search);
      const durationParam = params.get('duration');
      const requestedDuration = Number(durationParam);
      const duration = durationParam !== null && Number.isFinite(requestedDuration)
        ? Math.max(1000, requestedDuration)
        : 4000;
      const fadeParam = params.get('fade');
      const requestedFade = Number(fadeParam);
      const fadeDuration = fadeParam !== null && Number.isFinite(requestedFade)
        ? Math.max(0, Math.min(requestedFade, duration))
        : Math.min(1500, duration);

      document.documentElement.style.setProperty(
        '--fade-duration',
        `${fadeDuration}ms`
      );

      let queue = [];
      let activeSlide = 0;
      let lastUrl = '';

      function shuffle(items) {
        const shuffled = [...items];
        for (let index = shuffled.length - 1; index > 0; index -= 1) {
          const randomIndex = Math.floor(Math.random() * (index + 1));
          [shuffled[index], shuffled[randomIndex]] = [
            shuffled[randomIndex],
            shuffled[index],
          ];
        }
        return shuffled;
      }

      function refillQueue() {
        queue = shuffle(slideshowItems);
        if (queue.length > 1 && queue[0].url === lastUrl) {
          [queue[0], queue[1]] = [queue[1], queue[0]];
        }
      }

      function nextItem() {
        if (queue.length === 0) refillQueue();
        const item = queue.shift();
        lastUrl = item?.url ?? '';
        return item;
      }

      function loadItem(slide, item) {
        return new Promise((resolve) => {
          const image = slide.querySelector('.slide-image');
          const artistName = slide.querySelector('.artist-name');
          if (!image || !artistName || !item) {
            resolve(false);
            return;
          }

          image.onload = () => resolve(true);
          image.onerror = () => resolve(false);
          artistName.textContent = item.artistName
            ? `${item.artistName}さん`
            : '';
          image.src = item.url;
        });
      }

      async function advance() {
        const incomingIndex = activeSlide === 0 ? 1 : 0;
        const incoming = slides[incomingIndex];
        const outgoing = slides[activeSlide];
        const item = nextItem();

        if (!item || !incoming) return;

        const loaded = await loadItem(incoming, item);
        if (!loaded) {
          window.setTimeout(advance, 100);
          return;
        }

        incoming.classList.add('is-visible');
        outgoing?.classList.remove('is-visible');
        activeSlide = incomingIndex;
        window.setTimeout(advance, duration);
      }

      if (slideshowItems.length === 0) {
        slides.forEach((slide) => slide.remove());
        if (emptyMessage) emptyMessage.hidden = false;
      } else {
        const firstItem = nextItem();
        loadItem(slides[0], firstItem).then(() => {
          window.setTimeout(advance, duration);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: only light;
    background: transparent;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: transparent;
  }

  .slideshow {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) 80px;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    transition: opacity var(--fade-duration, 1500ms) ease;
  }

  .slide.is-visible {
    opacity: 1;
  }

  .slide-image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  .artist-name {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0 20px;
    color: #fff;
    font-family: 'Zen Maru Gothic', sans-serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
  }

  .empty-message {
    margin: 0;
    color: #fff;
    font: 16px sans-serif;
  }
</style>
