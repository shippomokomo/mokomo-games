---
import { readdirSync } from 'node:fs';
import { withBase } from '../utils/paths';

const imageUrls = readdirSync('public/images/illustrations')
  .filter((filename) => filename.toLowerCase().endsWith('.webp'))
  .sort((a, b) => a.localeCompare(b, 'en'))
  .map((filename) =>
    withBase(`/images/illustrations/${encodeURIComponent(filename)}`)
  );
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Illustration Slideshow | Mokomo Games</title>
  </head>
  <body>
    <main class="slideshow" aria-label="イラストスライドショー">
      <img class="slide is-visible" alt="" />
      <img class="slide" alt="" />
      <p class="empty-message" hidden>表示できるWebP画像がありません。</p>
    </main>

    <script define:vars={{ imageUrls }}>
      const slides = Array.from(document.querySelectorAll('.slide'));
      const emptyMessage = document.querySelector('.empty-message');
      const params = new URLSearchParams(window.location.search);
      const requestedDuration = Number(params.get('duration'));
      const duration = Number.isFinite(requestedDuration)
        ? Math.max(1000, requestedDuration)
        : 4000;

      let queue = [];
      let activeSlide = 0;
      let lastUrl = '';

      function shuffle(items) {
        const shuffled = [...items];
        for (let index = shuffled.length - 1; index > 0; index -= 1) {
          const randomIndex = Math.floor(Math.random() * (index + 1));
          [shuffled[index], shuffled[randomIndex]] = [
            shuffled[randomIndex],
            shuffled[index],
          ];
        }
        return shuffled;
      }

      function refillQueue() {
        queue = shuffle(imageUrls);
        if (queue.length > 1 && queue[0] === lastUrl) {
          [queue[0], queue[1]] = [queue[1], queue[0]];
        }
      }

      function nextUrl() {
        if (queue.length === 0) refillQueue();
        const url = queue.shift() ?? '';
        lastUrl = url;
        return url;
      }

      function loadImage(element, url) {
        return new Promise((resolve) => {
          element.onload = () => resolve(true);
          element.onerror = () => resolve(false);
          element.src = url;
        });
      }

      async function advance() {
        const incomingIndex = activeSlide === 0 ? 1 : 0;
        const incoming = slides[incomingIndex];
        const outgoing = slides[activeSlide];
        const url = nextUrl();

        if (!url || !incoming) return;

        const loaded = await loadImage(incoming, url);
        if (!loaded) {
          window.setTimeout(advance, 100);
          return;
        }

        incoming.classList.add('is-visible');
        outgoing?.classList.remove('is-visible');
        activeSlide = incomingIndex;
        window.setTimeout(advance, duration);
      }

      if (imageUrls.length === 0) {
        slides.forEach((slide) => slide.remove());
        if (emptyMessage) emptyMessage.hidden = false;
      } else {
        const firstUrl = nextUrl();
        loadImage(slides[0], firstUrl).then(() => {
          window.setTimeout(advance, duration);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: only light;
    background: transparent;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: transparent;
  }

  .slideshow {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .slide.is-visible {
    opacity: 1;
  }

  .empty-message {
    margin: 0;
    color: #fff;
    font: 16px sans-serif;
  }
</style>
