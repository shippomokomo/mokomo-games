---
import Header from '../components/Header.astro';

const { title = 'Mokomo Games' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    font-family: sans-serif;
    margin: 2rem;
    line-height: 1.7;
  }

  main {
    margin-top: 2rem;
  }
</style>